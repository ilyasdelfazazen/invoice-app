# Copy this file to .env and fill in real values.
# .env is read automatically by `docker compose` for variable substitution
# in docker-compose.yml — never commit the real .env file.

MONGO_ROOT_USER=dbadmin
MONGO_ROOT_PASSWORD=change_me
MONGO_DB_NAME=sce-manager

JWT_SECRET=change_me_to_a_long_random_string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
